# Public URL of the deployed site (used for SEO, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://vergelcortez.vercel.app

# Contact form delivery via Resend (https://resend.com). Free tier is enough.
# Without this key the form shows a friendly "email me directly" error.
RESEND_API_KEY=
# Where messages are delivered.
CONTACT_TO_EMAIL=vergelcortez99@gmail.com
# Sender. "onboarding@resend.dev" works without a verified domain.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
